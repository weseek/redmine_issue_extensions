<% if IssueExtensions.enabled?(issue.project) -%>
<hr />
<div id="issue_extensions_form">
  <p><strong><%= l(:issue_extensions) %></strong></p>
  <div id="issue_extensions_relations">
    <p>
    <% if User.current.allowed_to?(:add_issues, issue.project) %>
      <%= link_to l(:label_add_relation_issue), new_project_issue_path(issue.project, :relation_issue => issue.id), :class => 'icon icon-add' %><br />
    <% end %>
    <% if User.current.allowed_to?(:copy_issues, issue.project) %>
      <%= link_to l(:label_add_duplicate_issue), project_copy_issue_path(issue.project, issue, :duplicate_issue => 't'), :class => 'icon icon-copy' %>
    <% end %>
    </p>
  </div>
</div>
<% end -%>
